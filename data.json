      {
        "html": "<span class=\"ai\">✨</span>",
        "atHtml": "<strong contenteditable=\"true\" spellcheck=\"false\" data-editable=\"true\"><span style=\"color: rgb(26, 26, 26); font-size: 14px;\">Besakih – Mother Temple of Bali</span></strong><div class=\"maps-block\" data-map-id=\"map_al_3_1781600632931\">\n          <span class=\"maps-label\">🗺️</span>\n          <a href=\"https://maps.app.goo.gl/JLYsGBHNLrTo18JE8\" class=\"maps-link\" target=\"_blank\" style=\"\">View on Map</a>\n          <button class=\"maps-edit-btn\" title=\"Edit Map Link\">✏️</button>\n        </div><br><span contenteditable=\"true\" spellcheck=\"false\" data-editable=\"true\"><span style=\"color: rgb(92, 92, 92);\">The holiest and largest temple complex on the slopes of Mt. Agung. Over 80 shrines. Entry IDR 150k. Hire an official guide inside (not the touts at entrance). Dress: full sarong + sash.</span></span>"
