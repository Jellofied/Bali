      {
        "html": "<span class=\"ai\">🌿</span>",
        "atHtml": "<strong contenteditable=\"true\" spellcheck=\"false\" data-editable=\"true\">Mangrove Forest</strong><div class=\"maps-block\" data-map-id=\"map_al_7_1\">\n            <span class=\"maps-label\">🗺️</span>\n            <a href=\"https://maps.app.goo.gl/2ZShSKqrkPeGq3ZTA\" class=\"maps-link\" target=\"_blank\">View on Map</a>\n            <button class=\"maps-edit-btn\" title=\"Edit Map Link\">✏️</button>\n          </div><br><span contenteditable=\"true\" spellcheck=\"false\" data-editable=\"true\">Glide through emerald mangrove tunnels by canoe or small boat. Serene, otherworldly\n                  green light.</span>"
      }
    ],
    "al_8": [
      {
        "html": "<span class=\"ai\">✨</span>",
        "atHtml": "<strong contenteditable=\"true\" spellcheck=\"false\" data-editable=\"true\"><span style=\"color: rgb(26, 26, 26); font-size: 14px;\">Snorkelling – Crystal Bay / Mangrove Bay</span></strong><div class=\"maps-block\" data-map-id=\"map_al_8_1781601778938\">\n          <span class=\"maps-label\">🗺️</span>\n          <a href=\"https://maps.app.goo.gl/6A7dpxoAryW2U9XF9\" class=\"maps-link\" target=\"_blank\" style=\"\">View on Map</a>\n          <button class=\"maps-edit-btn\" title=\"Edit Map Link\">✏️</button>\n        </div><br><span contenteditable=\"true\" spellcheck=\"false\" data-editable=\"true\"><span style=\"color: rgb(92, 92, 92);\">Brilliant coral with clownfish, turtles &amp; if lucky — Manta Rays. Rent snorkel gear from any beach shack (IDR 50k). For Mantas, go to Manta Point via boat tour.</span></span>"
      },
      {
        "html": "<span class=\"ai\">💙</span>",
        "atHtml": "<strong contenteditable=\"true\" spellcheck=\"false\" data-editable=\"true\">Blue Lagoon, Ceningan</strong><div class=\"maps-block\" data-map-id=\"map_al_8_1\">\n            <span class=\"maps-label\">🗺️</span>\n            <a href=\"https://maps.app.goo.gl/u9Gyc4xmRUj2DXjE9\" class=\"maps-link\" target=\"_blank\" style=\"\">View on Map</a>\n            <button class=\"maps-edit-btn\" title=\"Edit Map Link\">✏️</button>\n          </div><br><span contenteditable=\"true\" spellcheck=\"false\" data-editable=\"true\">Brilliant turquoise cove with cliff jump platforms. Cafe above for drinks with the\n                  view (Klyf Club has a stunning terrace).</span>"
      }
    ],
    "al_18": [
      {
        "html": "<span class=\"ai\">🍛</span>",
        "atHtml": "\n                <strong contenteditable=\"true\" spellcheck=\"false\" data-editable=\"true\">Locavore</strong>\n                <div class=\"maps-block\" data-map-id=\"map_rest_17\">\n              <span class=\"maps-label\">🗺️ </span>\n              <a href=\"#\" class=\"maps-link placeholder\" target=\"_blank\">Add Map Link</a>\n              <button class=\"maps-edit-btn\" title=\"Edit Map Link\">✏️</button>\n            </div>\n                <br>\n                <span contenteditable=\"true\" spellcheck=\"false\" data-editable=\"true\">Award-winning fine dining using only\n              Balinese local ingredients. Tasting menu. Special occasion dinner. Book 2–3 weeks ahead.</span>\n              "
