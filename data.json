    "list_al_3": {
      "title_0": "Goa",
      "title_1": "Tirta Gangga Water Palace",
      "title_2": "<span style=\"color: rgb(26, 26, 26); font-size: 14px;\">Besakih – Mother Temple of Bali</span>",
      "desc_2": "<span style=\"color: rgb(92, 92, 92);\">The holiest and largest temple complex on the slopes of Mt. Agung. Over 80 shrines. Entry IDR 150k. Hire an official guide inside (not the touts at entrance). Dress: full sarong + sash.</span>"
    },
    "list_al_0": {
      "title_0": "Sanur Beachfront Boardwalk",
      "title_3": "<span style=\"display: block; font-weight: 500; font-size: 13.5px; color: rgb(28, 28, 28); font-family: &quot;DM Sans&quot;, sans-serif; background-color: rgb(255, 255, 255);\">Hyatt Sea Turtle Conservation — Boardwalk</span>",
      "desc_3": "<span style=\"color: rgb(90, 90, 90); font-family: &quot;DM Sans&quot;, sans-serif; font-size: 12.5px; background-color: rgb(255, 255, 255);\">Walk 20 min north along the boardwalk to the Hyatt's beach turtle programme. View rescued and hatching sea turtles in care. June is nesting season — very active</span>"
    },
    "transport": {
      "t_0": "<strong>Transport</strong>\n          Airport → Sanur: Pre-book a private cab or use Bluebird taxi (metered, most reliable). ~30–40 min, ~IDR\n          150–200k. Avoid touts inside arrivals. All Sanur activities are walkable along the 5 km beach boardwalk. Rent\n          bicycles (IDR 50k/day) from your hotel for easy exploration.\n        ",
      "t_2": "<strong>Hired Private Car &amp; Driver (full day)</strong>\n          Hire from hotel or Klook/GetYourGuide. Full day east Bali circuit: IDR 600–800k. Route: Sanur → Lempuyang (2.5\n          hrs) → Tirta Gangga (20 min from Lempuyang) → Besakih (1 hr from Tirta Gangga) → optional Sidemen Valley →\n          back to Sanur. ~200 km round trip. Driver handles parking; you focus on photography.\n        ",
      "t_5": "<strong>Hired Car: Ubud → Jatiluwih → Nusa Dua</strong>\n          Full day hire: IDR 700–900k. Route: Ubud → Jatiluwih Rice Terraces (1.5 hr) → Tanah Lot area for lunch →\n          Uluwatu Temple (2 hr drive south) → Jimbaran Bay dinner → Nusa Dua hotel check-in. Note: Grab/Gojek cannot\n          enter Jatiluwih; private car essential.\n        "
    },
    "tipbox": {
      "tip_0": "\n        <strong>📍 Arrival Note</strong>\n        Check in, freshen up. Sanur is the perfect relaxed entry into Bali — calm beach, no surf crowds, great food. The\n        famous 5 km beachfront boardwalk links everything.\n      ",
      "tip_2": "\n        <strong>⏰ Timing Tip for Lempuyang</strong>\n        Arrive by 9–9:30 AM. The queue for the Gate of Heaven photo grows to 2–3 hours by midday. Early arrivals wait\n        ~30–45 min. Wear modest dress (sarong provided). No mirror at the base — it's a phone held under the gate for\n        the reflection shot.\n      "
    },
    "list_al_4": {
      "title_0": "Besakih – Mother Temple of Bali",
      "title_1": "<span style=\"display: block; font-weight: 500; font-size: 13.5px; color: rgb(28, 28, 28); font-family: &quot;DM Sans&quot;, sans-serif; background-color: rgb(255, 255, 255);\">Taman Ujung Water Palace</span>",
      "desc_1": "<span style=\"color: rgb(90, 90, 90); font-family: &quot;DM Sans&quot;, sans-serif; font-size: 12.5px; background-color: rgb(255, 255, 255);\">Built by the same king as Tirta Gangga — equally beautiful, far less visited. Massive ornamental ponds with stone bridges, Mount Agung backdrop, and views of the Lombok Strait from the upper terrace. Entry IDR 100k. Only 20 min drive from Tirta Gangga.</span>",
      "desc_0": "The holiest and largest temple complex on the slopes of Mt.\n                  Agung. Over 80 shrines. Entry IDR 150k. Hire an official guide inside (not the touts at entrance).\n                  Dress: full sarong + sash."
    },
    "list_al_1": {
