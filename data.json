    "al_1": [
      {
        "html": "<span class=\"ai\">✨</span>",
        "atHtml": "<strong contenteditable=\"true\" spellcheck=\"false\" data-editable=\"true\"><span style=\"color: rgb(28, 28, 28); font-family: &quot;DM Sans&quot;, sans-serif; font-size: 13.5px; font-weight: 500; background-color: rgb(255, 255, 255);\">Warung Mak Beng</span></strong><div class=\"maps-block\" data-map-id=\"map_al_1_1781600163651\">\n          <span class=\"maps-label\">🗺️</span>\n          <a href=\"https://maps.app.goo.gl/VtDmy566JLzqZMaT6\" class=\"maps-link\" target=\"_blank\">View on Map</a>\n          <button class=\"maps-edit-btn\" title=\"Edit Map Link\">✏️</button>\n        </div><br><span contenteditable=\"true\" spellcheck=\"false\" data-editable=\"true\"><span style=\"color: rgb(92, 92, 92);\">On the return route — one of Bali's most beautiful river valleys with lush terraced rice fields. Ask driver to stop at Pura Kehen viewpoint for photos.</span></span>"
      },
      {
        "html": "<span class=\"ai\">🔄</span>",
        "atHtml": "\n                <strong contenteditable=\"true\" spellcheck=\"false\" data-editable=\"true\"><span style=\"color: rgb(28, 28, 28); font-family: &quot;DM Sans&quot;, sans-serif; font-size: 13.5px; font-weight: 500; background-color: rgb(255, 255, 255);\">Moreno Beach Bali</span></strong>\n                <div class=\"maps-block\" data-map-id=\"map_rest_1\">\n              <span class=\"maps-label\">🗺️ </span>\n              <a href=\"https://maps.app.goo.gl/6iQdPUmGVXtfFyWGA\" class=\"maps-link\" target=\"_blank\">View on Map</a>\n              <button class=\"maps-edit-btn\" title=\"Edit Map Link\">✏️</button>\n            </div>\n                <br>\n                <span contenteditable=\"true\" spellcheck=\"false\" data-editable=\"true\">Italian-Indonesian fusion right on the sand.\n                Great for arriving weary travellers who want to ease in gently. Pasta, fresh barramundi. Jl. Segara Ayu\n                No.42</span>\n              "
      }
    ],
    "al_5": [
      {
        "html": "<span class=\"ai\">🌿</span>",
        "atHtml": "\n                <strong contenteditable=\"true\" spellcheck=\"false\" data-editable=\"true\">Breakfast Panorama Sidemen</strong>\n                <div class=\"maps-block\" data-map-id=\"map_rest_9\">\n              <span class=\"maps-label\">🗺️ </span>\n              <a href=\"https://maps.app.goo.gl/vQaZpQvNnHDbvGaM9\" class=\"maps-link\" target=\"_blank\">View on Map</a>\n              <button class=\"maps-edit-btn\" title=\"Edit Map Link\">✏️</button>\n            </div>\n                <br>\n                <span contenteditable=\"true\" spellcheck=\"false\" data-editable=\"true\">On the Sidemen road with rice terrace views.\n              Local Balinese cuisine, cold beer, shaded terrace. Great rest stop.</span>\n              "
