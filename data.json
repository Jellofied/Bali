    "al_7": [
      {
        "html": "<span class=\"ai\">🌊</span>",
        "atHtml": "<strong contenteditable=\"true\" spellcheck=\"false\" data-editable=\"true\">Devil's Tear</strong><div class=\"maps-block\" data-map-id=\"map_al_7_0\">\n            <span class=\"maps-label\">🗺️</span>\n            <a href=\"https://maps.app.goo.gl/uD7z8zaRd2eHJMWv5\" class=\"maps-link\" target=\"_blank\">View on Map</a>\n            <button class=\"maps-edit-btn\" title=\"Edit Map Link\">✏️</button>\n          </div><br><span contenteditable=\"true\" spellcheck=\"false\" data-editable=\"true\">Dramatic cliff where waves crash violently into a natural channel, spraying 15 m\n                  into the air. Sunrise or early morning best. Most iconic spot on Lembongan.</span><span class=\"photo-badge\">📸 Photo: wave spray silhouette shot</span>"
      },
      {
        "html": "<span class=\"ai\">✨</span>",
        "atHtml": "<strong contenteditable=\"true\" spellcheck=\"false\" data-editable=\"true\">Sandy Bay Beach Club</strong><div class=\"maps-block\" data-map-id=\"map_al_7_1781601416547\">\n          <span class=\"maps-label\">🗺️</span>\n          <a href=\"https://maps.app.goo.gl/j74U8M5jhkJj8FMd9\" class=\"maps-link\" target=\"_blank\">View on Map</a>\n          <button class=\"maps-edit-btn\" title=\"Edit Map Link\">✏️</button>\n        </div><br><span contenteditable=\"true\" spellcheck=\"false\" data-editable=\"true\">Add your description here</span>"
