    "list_al_2": {
      "desc_1": "<span style=\"color: rgb(90, 90, 90); font-family: &quot;DM Sans&quot;, sans-serif; font-size: 12.5px; background-color: rgb(255, 255, 255);\">Sanur's restaurant strip comes alive after 7 PM. Try Sate Lilit (fish on lemongrass skewer), Es Campur shaved ice, BBQ corn stalls.</span>",
      "title_0": "<span style=\"color: rgb(28, 28, 28); font-family: &quot;DM Sans&quot;, sans-serif; font-size: 13.5px; font-weight: 500; background-color: rgb(255, 255, 255);\">Warung Be Sanur</span>",
      "title_1": "<span style=\"color: rgb(28, 28, 28); font-family: &quot;DM Sans&quot;, sans-serif; font-size: 13.5px; font-weight: 500; background-color: rgb(255, 255, 255);\">Jl. Danau Tamblingan Night Walk</span>",
      "desc_0": "<span style=\"color: rgb(90, 90, 90); font-family: &quot;DM Sans&quot;, sans-serif; font-size: 12.5px; background-color: rgb(255, 255, 255);\">Grilled fish, chicken satay, Balinese black rice pudding. Authentic and affordable.</span>"
    },
    "restaurants": {
      "r_1": "Bali's most legendary warung. Only one menu\n                — crispy fried fish, spicy fish soup, sambal &amp; rice. IDR 55k/person. Queue expected; arrive by 12:30\n                or after 2 PM. Jl. Hang Tuah No.45"
